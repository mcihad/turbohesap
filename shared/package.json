{
  "name": "@turbohesap/shared",
  "version": "0.1.0",
  "description": "Shared, framework-agnostic contracts for TurboHesap: DTO models, service interfaces, and their axios-based client implementations. Consumed by the web frontend and the React Native mobile app.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "dev": "tsc -p tsconfig.esm.json --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "typescript": "~5.7.2"
  }
}
