# TurboHesap configuration. The Makefile loads this for every command; the NestJS
# backend reads it at startup (process environment always wins); Vite reads the
# VITE_-prefixed vars. Copy to .env and adjust.

# ── Backend ──────────────────────────────────────────────────────────────
# HTTP server bind interface and port.
HOST=0.0.0.0
PORT=5800

# Application environment: development | production
APP_ENV=development

# Browser cache lifetime (seconds) for the built frontend assets. The HTML
# entrypoint is always revalidated regardless of this value.
STATIC_CACHE_MAX_AGE=3600

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgres://kentos:kentos@localhost:5432/turbohesap
# The schema is owned by migrations (no auto-synchronize). Pending migrations run
# on boot; set to false for multi-instance deploys that run `make migrate`
# out-of-band before starting the app.
DB_MIGRATIONS_RUN=true

# ── Auth (local JWT) ──────────────────────────────────────────────────────
# Separate secrets for access and refresh tokens. CHANGE THESE in production.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# Token lifetimes: a number (seconds) or an ms-style string (e.g. 15m, 7d, 12h).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Seed admin (created on first boot if missing) ─────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_EMAIL=admin@turbohesap.local

# ── Security ──────────────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated). Empty: open in dev, same-origin only in
# prod. e.g. CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=
# Global rate limit: max requests per window (ms). login/client-error are tighter.
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
# NOTE: in production the app refuses to boot while JWT_*_SECRET / SEED_ADMIN_PASSWORD
# are still the defaults above — set real values.

# ── Frontend (Vite) ──────────────────────────────────────────────────────
# Only VITE_-prefixed variables are exposed to the browser. Base path of the
# JSON API; the shared client builds every path (/api/<module>/<resource>) from
# this base.
VITE_API_BASE_URL=/api

# ── File storage ─────────────────────────────────────────────────────────
# Where uploaded files/images are stored. FILE_STORAGE=local keeps bytes in a
# local directory (FILE_LOCAL_DIR); FILE_STORAGE=s3 uses an S3 (or S3-compatible)
# bucket. The DB always holds the metadata; only the bytes location differs.
FILE_STORAGE=local
FILE_LOCAL_DIR=storage/uploads
FILE_MAX_SIZE_MB=25
# S3 (only used when FILE_STORAGE=s3). S3_ENDPOINT is for S3-compatible stores
# (MinIO, Cloudflare R2…); leave empty for AWS. Set S3_FORCE_PATH_STYLE=true for MinIO.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ── Cache (analiz/istatistik) ─────────────────────────────────────────────
# Analitik sonuçları cache'lenir. CACHE_STORE=memory (varsayılan) uygulama-içi
# bellekte tutar (tek instance). Çok-instance için redis veya memcached seçin.
# CACHE_TTL saniye cinsinden geçerlilik; CACHE_PREFIX paylaşılan store'da
# isim-uzayı; CACHE_MEMORY_MAX bellek modunda azami kayıt sayısı.
CACHE_STORE=memory
CACHE_TTL=60
CACHE_PREFIX=th:
CACHE_MEMORY_MAX=1000
# Redis (yalnız CACHE_STORE=redis). REDIS_URL host/port'tan önceliklidir.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Memcached (yalnız CACHE_STORE=memcached). Sunucular virgülle ayrılır.
MEMCACHED_SERVERS=127.0.0.1:11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=

# Satıcı (kendi firma) bilgileri — fatura UBL-TR (e-Fatura/e-Arşiv) XML'inde
# "AccountingSupplierParty" olarak kullanılır.
COMPANY_NAME=TurboHesap A.Ş.
COMPANY_VKN=1111111111
COMPANY_TAX_OFFICE=Merkez
COMPANY_ADDRESS=
COMPANY_CITY=
