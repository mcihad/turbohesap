# Copy this file to .env and adjust. All KentOS Console configuration is read
# from .env — the Makefile loads it for every command, and the backend binary
# also reads it at startup (process environment always wins over .env).

# ── Backend ──────────────────────────────────────────────────────────────
# HTTP server bind interface and port.
HOST=0.0.0.0
PORT=5800

# Application environment: development | production
APP_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL connection string. Leave empty to run without a database.
# Example: postgres://user:pass@localhost:5432/kentos?sslmode=disable
DATABASE_URL=

# Browser cache lifetime (seconds) for embedded frontend assets. Kept short
# because the frontend is rebuilt often — max ~1 hour. The HTML entrypoint is
# always revalidated regardless of this value.
STATIC_CACHE_MAX_AGE=3600

# ── Keycloak (OIDC) ──────────────────────────────────────────────────────
# Latest Keycloak. The OIDC client_id is the MODULE NAME (kentos.module.json
# "name") — it is not configured here. Discovery is read from:
#   ${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}/.well-known/openid-configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sivasbeltr

# Confidential client secret — used only by the backend for the code→token
# exchange and refresh. Never shipped to the browser. Fill in for real use.
KEYCLOAK_CLIENT_SECRET=

# Optional: override the OAuth redirect/callback URI. When empty it is derived
# per request as <request-base-url>/auth/callback (e.g. http://localhost:5800/auth/callback).
# KEYCLOAK_REDIRECT_URI=

# ── Frontend (Vite) ──────────────────────────────────────────────────────
# Only VITE_-prefixed variables are exposed to the browser. Vite reads this
# same root .env (see vite.config.ts envDir).
# Base path of the module's JSON API.
VITE_API_BASE_URL=/api/v1
