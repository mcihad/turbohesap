# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & build output
node_modules
dist
dist-ssr
*.local

# Go binary output
/bin/

# Local environment — keep .env.example tracked, ignore the real .env
.env
.env.local
!.env.example

# Frontend build embedded into the backend binary.
# The placeholder index.html is tracked so `go build` works on a fresh
# checkout; everything Vite generates on top of it is ignored.
/backend/static/*
!/backend/static/index.html

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
