# Expo only exposes EXPO_PUBLIC_-prefixed variables to the app. Copy to
# mobile/.env and adjust.

# Backend API base URL. On a real device, localhost is the phone — point this at
# your machine's LAN address (e.g. http://192.168.1.20:5800/api).
EXPO_PUBLIC_API_BASE_URL=http://localhost:5800/api

# Module name (kentos.module.json "name") — used to build the metadata path.
EXPO_PUBLIC_MODULE_NAME=kentos-project-template
